<mujoco model="piper_x_cubes_in_cup_scene">
  <!-- Two-board tabletop, EXACT reference dims (piper-x-policy lift/joint_pos_env_cfg).
       Robot base at world origin, mounted at the near table edge.
         board1 (table)  40x70 cm, top z=0     center (0.14, 0, -0.0075)
         board2 (shelf)  35x70 cm, top z=0.13   center (0.445, 0, 0.1225), x 0.27..0.62
       Cubes and cup both sit ON the upper shelf (board2). Cube+cup are re-sampled
       per episode by the task sampler; the poses here are nominal spawns. -->
  <!-- cone=elliptic + impratio=10: the MuJoCo-documented grasping setup.
       At the default (pyramidal, impratio 1) friction constraints are as soft
       as normal ones, so held cubes creep ~17 mm through the pads per carry;
       measured 2026-07-26 (piper_x_grip_slip_probe.py): this cuts it to 1-7 mm
       with zero torsional spin either way. -->
  <option integrator="implicit" timestep="0.002" cone="elliptic" impratio="10"/>

  <!-- Anchor the scene scale explicitly (Menagerie convention): the auto-computed
       extent (~11 m, dominated by the floor plane) makes znear = 0.01*extent ≈ 11 cm,
       which near-clips the gripper out of the wrist camera. extent 1.2 -> znear 12 mm. -->
  <statistic center="0.3 0 0.15" extent="1.2"/>

  <asset>
    <model name="cube_model" file="cube/cube.xml"/>
    <model name="cup_model" file="cup/cup.xml"/>
    <!-- brighter checker so the mid-tone base has headroom: rgba DR jitter then
         swings the ground colour visibly instead of washing out near white. -->
    <texture name="floor_tex" type="2d" builtin="checker" rgb1="0.55 0.6 0.68" rgb2="0.42 0.47 0.55"
             width="512" height="512"/>
    <!-- floor must NOT be reflective: the renderer mirrors only the first
         reflective geom, and the floor would steal the slot from board2.
         Mid-tone base rgba (not the default white) so continuous rgba DR gives
         wide, visible ground-colour variation per episode. -->
    <material name="floor_mat" texture="floor_tex" texrepeat="6 6" texuniform="true"
              rgba="0.7 0.72 0.75 1"/>
    <!-- glossy black boards. MuJoCo's classic renderer mirrors only ONE
         reflective geom per scene, so the shelf (board2, where cubes + cup
         live) gets the true reflection; board1 is specular-only black. -->
    <material name="board_mat" rgba="0.04 0.04 0.04 1" specular="0.05" shininess="0.1"/>
    <material name="board2_mat" rgba="0.04 0.04 0.04 1" specular="0.05" shininess="0.1" reflectance="0.08"/>
    <!-- backdrop wall material (muted blue-grey). Small emission keeps it legible
         even though the key/fill lights only graze a vertical face. No
         reflectance: board2 must stay the single reflective geom the classic
         renderer mirrors. -->
    <!-- flat texture (same color as before) rather than a bare rgba: only geoms
         whose material HAS a texture are texture-swap targets for the DR
         texture randomizer (dr_texture_paths, e.g. DTD photos). -->
    <texture name="backdrop_tex" type="2d" builtin="flat" rgb1="0.28 0.32 0.42" width="64" height="64"/>
    <material name="backdrop_mat" texture="backdrop_tex" texrepeat="1 1" texuniform="true"
              specular="0.2" shininess="0.2" emission="0.35"/>
  </asset>

  <worldbody>
    <!-- floor: collision plane (physics, invisible) + visual plane (randomizable
         ground). Surplus/parked cubes rest on the collision plane at z=-0.725;
         the visual plane sits 0.2 mm below so it never clips them. Split so
         TextureRandomizer (visual geoms only) can re-skin the ground. -->
    <geom name="floor" type="plane" size="2 2 0.1" pos="0 0 -0.74" rgba="0 0 0 0" group="3"/>
    <geom name="floor_visual" type="plane" size="2 2 0.1" pos="0 0 -0.7402"
          material="floor_mat" contype="0" conaffinity="0"/>
    <!-- backdrop wall behind the workspace, at -x (behind the arm base, facing
         the exo/diag camera which sits at x=1.17 looking toward -x): a visual-only
         geom TextureRandomizer re-skins each episode. Fills the background for the
         exo/diag views; a full surround would need more walls or a skybox. -->
    <geom name="backdrop" type="box" pos="-0.7 0 0.6" size="0.02 3.5 2.5"
          material="backdrop_mat" contype="0" conaffinity="0"/>
    <!-- exocentric "diag view" camera, WORLD-fixed. Hardcoded copy of the
         base-mounted exo_camera in assets/piper_x/piper_x.xml (identical
         numbers while the base sat at the origin): the robot base pose is
         randomized per episode and the diag framing must not move with it. -->
    <camera name="exo_camera" pos="1.1717 -0.31 0.5726"
            xyaxes="0.342 0.9397 0 -0.3971 0.1445 0.9063" fovy="45"/>
    <light name="key_light" pos="0.6 -0.6 1.6" dir="-0.3 0.3 -1" directional="true" diffuse="0.8 0.8 0.8"/>
    <light name="fill_light" pos="-0.4 0.6 1.4" dir="0.3 -0.4 -1" directional="true" diffuse="0.4 0.4 0.4"/>

    <!-- Boards are split into a COLLISION geom (physics, invisible) and a
         VISUAL geom (contype==0, carries the material). TextureRandomizer only
         touches visual geoms, so this split is what lets it randomize the board
         surface (rgba/specular/shininess/reflectance). The material + reflectance
         live ONLY on the visual geom, so board2_visual stays the single reflective
         geom the classic renderer mirrors. The visual top sits +0.2 mm proud of the
         collision top to avoid coplanar z-fighting (imperceptible, well under the
         ~1 mm cube seating tolerance). -->
    <!-- board 1: main table, top surface at z=0 (arm mounted at its near edge) -->
    <geom name="board1" type="box" pos="0.14 0 -0.0075" size="0.20 0.35 0.0075" rgba="0 0 0 0" group="3"/>
    <geom name="board1_visual" type="box" pos="0.14 0 -0.0073" size="0.20 0.35 0.0075"
          material="board_mat" contype="0" conaffinity="0"/>
    <!-- board 2: upper shelf, top surface at z=0.13, cantilevered behind -->
    <geom name="board2" type="box" pos="0.445 0 0.1225" size="0.175 0.35 0.0075" rgba="0 0 0 0" group="3"/>
    <geom name="board2_visual" type="box" pos="0.445 0 0.1227" size="0.175 0.35 0.0075"
          material="board2_mat" contype="0" conaffinity="0"/>

    <!-- cubes on the shelf (nominal; re-sampled per episode: 1-4 active, extras
         parked on the floor by the task sampler). Seated ~1mm into the shelf
         (z=0.144, not 0.145) so a contact registers at scene setup -- the task
         sampler's get_supporting_geom needs an actual cube<->board2 contact. -->
    <frame pos="0.32 0.0 0.144">
      <attach model="cube_model" prefix=""/>
    </frame>
    <frame pos="0.36 -0.08 0.144">
      <attach model="cube_model" prefix="cube2_"/>
    </frame>
    <frame pos="0.36 0.08 0.144">
      <attach model="cube_model" prefix="cube3_"/>
    </frame>
    <frame pos="0.39 0.0 0.144">
      <attach model="cube_model" prefix="cube4_"/>
    </frame>
    <!-- cup on the shelf (nominal; re-sampled per episode). Base seated ~1mm in. -->
    <frame pos="0.30 0.17 0.129">
      <attach model="cup_model" prefix=""/>
    </frame>
  </worldbody>
</mujoco>
